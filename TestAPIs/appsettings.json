{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Settings": {
    "FrontendUrl": "https://localhost:32769/",
    "BaseUrl": "https://localhost:32769/",
    "Android": {
      "Scheme": "https",
      "Host": "https://localhost:32769/",
      "VerifyEmailPath": "mypath"
    },
    "iOS": {
      "Scheme": "myapp",
      "Host": "myhost",
      "VerifyEmailPath": "mypath"
    }
  },
  "SMSwitchSettings": {
    "SupportedCountriesIsoCodes": [ "DK", "IN", "FI", "SE", "RO" ],
    "Controls": {
      "MaxRoundRobinAttempts": 2,
      "PriorityBasedOnCountryPhoneCode": {
        "45": [ "Plivo", "Twilio" ],
        "91": [ "Twilio" ]
      },
      "FallBackPriority": [ "Twilio", "Plivo" ],
      "MaximumFailedAttemptsToVerify": 3,
      "SessionTimeoutInSeconds": 240
    },
    "AndroidAppHash": "wah",
    "OtpLength": 5,
    "Twilio": {
      "AccountSid": "MovedToSecret",
      "AuthToken": "MovedToSecret",
      "ServiceSid": "MovedToSecret",
      "RegisteredSenderPhoneNumber": "MovedToSecret"
    },
    "Plivo": {
      "AuthId": "MovedToSecret",
      "AuthToken": "MovedToSecret",
      "AppUuid": "MovedToSecret"
    }
  },
  "MongoDbSettings": {
    "MongoDatabaseName": "SMSwitchTesting"
  }
}
